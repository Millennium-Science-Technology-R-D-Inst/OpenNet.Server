{
  "TraversalDirectory": {
    "HeartbeatLifetimeSeconds": 600,
    "CacheDurationSeconds": 5,
    "ManagementApiKey": "change-this-development-key",
    "SeedServers": [
      {
        "Name": "Local traversal node",
        "IPv4Address": "127.0.0.1",
        "ApiPort": 48100,
        "StunPort": 3478,
        "AlternateStunPort": 3479,
        "Priority": 100
      }
    ]
  },
  "UpdateCatalog": {
    "CacheDurationSeconds": 30,
    "Packages": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
