MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=opennet
MYSQL_USER=opennet
MYSQL_PASSWORD=replace-with-a-long-random-password
# 仅 compose.mysql.yaml 自带 MySQL 模式需要 root 密码。
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
# 自带 MySQL 默认只发布到宿主机回环地址；外部机器请优先通过 SSH 隧道连接。
MYSQL_PUBLISH_ADDRESS=127.0.0.1
MYSQL_PUBLISHED_PORT=13306
MYSQL_SSL_MODE=Preferred
OPENNET_MANAGEMENT_API_KEY=replace-with-a-long-random-api-key
